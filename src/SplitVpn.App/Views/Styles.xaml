<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:SplitVpn.App.Views">

    <views:VisibleWhenConverter x:Key="VisibleWhen" />
    <views:StepVisibilityConverter x:Key="StepVisible" />
    <views:InverseBoolConverter x:Key="Not" />
    <views:DecisionTextConverter x:Key="DecisionText" />
    <views:LocalTimeConverter x:Key="LocalTime" />
    <views:HasValueConverter x:Key="HasValue" />
    <views:SeverityConverter x:Key="ErrorSeverity" />
    <views:LevelToAppearanceConverter x:Key="LevelAppearance" />
    <views:DecisionToAppearanceConverter x:Key="DecisionAppearance" />
    <views:RoleToAppearanceConverter x:Key="RoleAppearance" />

    <!-- Типографика -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,16,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,12,0,4" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Карточка-контейнер -->
    <Style x:Key="PageCard" TargetType="ui:Card">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="ButtonRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,14,0,0" />
    </Style>
    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Строка настроек: значок | заголовок и описание | элемент управления -->
    <Style TargetType="views:CardRow">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:CardRow">
                    <Border
                        Padding="16,12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter
                                Grid.Column="0"
                                Width="24"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Icon}"
                                TextElement.FontSize="20"
                                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{TemplateBinding Title}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock
                                    FontSize="12.5"
                                    Margin="0,2,0,0"
                                    Text="{TemplateBinding Description}"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Плитка показателя -->
    <Style TargetType="views:Tile">
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:Tile">
                    <Border
                        Padding="16,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter Width="18" Margin="0,0,8,0" Content="{TemplateBinding Icon}" TextElement.FontSize="16"
                                                  TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock FontSize="12.5" Text="{TemplateBinding Caption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ContentPresenter Margin="0,8,0,0" Content="{TemplateBinding Content}" TextElement.FontSize="16"
                                              TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <!-- Длинное значение обрезается многоточием; полный текст — в подсказке плитки. -->
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Бейдж без лишних отступов -->
    <Style BasedOn="{StaticResource {x:Type ui:Badge}}" TargetType="ui:Badge">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
