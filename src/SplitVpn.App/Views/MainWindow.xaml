<ui:FluentWindow
    x:Class="SplitVpn.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SplitVpn.App.ViewModels"
    xmlns:views="clr-namespace:SplitVpn.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Раздельный VPN"
    Width="1080"
    Height="740"
    MinWidth="640"
    MinHeight="440"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    mc:Ignorable="d"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/app.ico"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary Source="Pages.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="Раздельный VPN" Grid.Row="0" ShowHelp="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            CompactPaneLength="48"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="232"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=TitleBar}"
            Transition="FadeInWithSlide"
            TransitionDuration="220">
            <ui:NavigationView.PaneHeader>
                <!-- Состояние всегда на виду: цветной индикатор плюс текст, не только цвет. -->
                <Border Margin="8,4,8,12" Padding="12,10" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding IsPaneOpen, ElementName=Navigation, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" views:Tone.Fill="{Binding Home.Tone}" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding StateText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding StateText, StringFormat=Состояние: {0}}"
                                       views:LiveRegion.Value="{Binding StateText}" />
                        </Grid>
                        <TextBlock Margin="18,2,0,0" FontSize="12" Text="{Binding Status.ProfileName, TargetNullValue=подключение не выбрано}"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Главная" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type views:HomePage}" />
                <ui:NavigationViewItem Content="Подключения" Icon="{ui:SymbolIcon PlugConnected24}" TargetPageType="{x:Type views:ConnectionsPage}" />
                <ui:NavigationViewItem Content="Маршрутизация" Icon="{ui:SymbolIcon Globe24}" TargetPageType="{x:Type views:RoutingPage}" />
                <ui:NavigationViewItem Content="Проверить адрес" Icon="{ui:SymbolIcon Search24}" TargetPageType="{x:Type views:CheckAddressPage}" />
                <ui:NavigationViewItem Content="Защита и DNS" Icon="{ui:SymbolIcon ShieldCheckmark24}" TargetPageType="{x:Type views:ProtectionPage}" />
                <ui:NavigationViewItem Content="Диагностика" Icon="{ui:SymbolIcon Pulse24}" TargetPageType="{x:Type views:DiagnosticsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Настройки" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type views:SettingsPage}" />
                <ui:NavigationViewItem Content="О программе" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type views:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.PaneFooter>
                <!-- Служба Windows на виду со всех страниц: состояние и управление ею (действия — с правами администратора). -->
                <Grid DataContext="{Binding ServiceHost}">
                    <Border x:Name="ServiceBlock" Margin="8" Padding="12,8,12,10" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Visibility="{Binding IsPaneOpen, ElementName=Navigation, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <!-- Подпись и версия — строкой выше: состояние («Останавливается…») не делит строку и не обрезается. -->
                            <StackPanel ToolTip="{Binding Description}" Background="Transparent">
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="Служба" /> <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </TextBlock>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" views:Tone.Fill="{Binding Tone}" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               AutomationProperties.Name="{Binding Description}" AutomationProperties.LiveSetting="Polite" views:LiveRegion.Value="{Binding Text}" />
                                </Grid>
                            </StackPanel>
                            <UniformGrid Margin="0,8,0,0" Rows="1" Columns="3">
                                <ui:Button Margin="0,0,4,0" Padding="0,6" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Play24}" Command="{Binding StartCommand}"
                                           ToolTip="Запустить службу" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Запустить службу" />
                                <ui:Button Margin="2,0,2,0" Padding="0,6" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopCommand}"
                                           ToolTip="Остановить службу" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Остановить службу" />
                                <ui:Button Margin="4,0,0,0" Padding="0,6" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RestartCommand}"
                                           ToolTip="Перезапустить службу" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Перезапустить службу" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <!-- Свёрнутое меню: значок службы с цветом состояния; управление — в раскрытом меню. -->
                    <Grid Width="40" Height="32" Margin="4,8,4,4" HorizontalAlignment="Left" Background="Transparent" ToolTip="{Binding Description}"
                          AutomationProperties.Name="{Binding Description}"
                          Visibility="{Binding IsPaneOpen, ElementName=Navigation, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <ui:SymbolIcon Symbol="Server24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Ellipse Width="8" Height="8" Margin="0,0,9,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" views:Tone.Fill="{Binding Tone}" />
                    </Grid>
                </Grid>
            </ui:NavigationView.PaneFooter>
            <ui:NavigationView.Header>
                <StackPanel MaxWidth="1040" Margin="28,8,28,0">
                    <!-- Идёт команда службе или действие страницы: полоса ожидания в шапке. Состояние не только
                         цветом — кнопка действия при этом называет, что происходит («Подключение…»). -->
                    <ProgressBar Height="3" Margin="0,0,0,8" IsIndeterminate="True" Focusable="False"
                                 Visibility="{Binding IsWorking, Converter={StaticResource VisibleWhen}}"
                                 AutomationProperties.Name="Идёт выполнение" AutomationProperties.LiveSetting="Polite"
                                 views:LiveRegion.Value="{Binding IsWorking}" />
                    <ui:InfoBar
                        Margin="0,0,0,8"
                        IsClosable="False"
                        IsOpen="{Binding ServiceAvailable, Converter={StaticResource Not}}"
                        Severity="Error"
                        Title="{Binding ServiceErrorTitle}"
                        Message="{Binding ServiceError}"
                        AutomationProperties.Name="{Binding ServiceError}"
                        AutomationProperties.LiveSetting="Assertive"
                        views:LiveRegion.Value="{Binding ServiceError}" />
                    <ui:InfoBar
                        Margin="0,0,0,8"
                        IsClosable="True"
                        IsOpen="{Binding CurrentPage.Message, Converter={StaticResource HasValue}, Mode=TwoWay}"
                        Severity="{Binding CurrentPage.MessageIsError, Converter={StaticResource ErrorSeverity}}"
                        Message="{Binding CurrentPage.Message}"
                        AutomationProperties.Name="{Binding CurrentPage.Message, TargetNullValue=''}"
                        AutomationProperties.LiveSetting="Assertive"
                        views:LiveRegion.Value="{Binding CurrentPage.Message}" />
                </StackPanel>
            </ui:NavigationView.Header>
        </ui:NavigationView>

        <!-- Мастер первого запуска поверх окна. -->
        <Grid x:Name="WizardHost" Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              Visibility="{Binding Wizard, Converter={StaticResource VisibleWhen}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ContentControl Content="{Binding Wizard}" MaxWidth="720" Margin="24" Focusable="False" />
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
