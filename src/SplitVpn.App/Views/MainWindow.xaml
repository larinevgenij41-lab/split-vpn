<ui:FluentWindow
    x:Class="SplitVpn.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SplitVpn.App.ViewModels"
    xmlns:views="clr-namespace:SplitVpn.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Раздельный VPN"
    Width="1080"
    Height="740"
    MinWidth="640"
    MinHeight="440"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    mc:Ignorable="d"
    ExtendsContentIntoTitleBar="True"
    Icon="pack://application:,,,/Assets/app.ico"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary Source="Pages.xaml" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="Раздельный VPN" Grid.Row="0" ShowHelp="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            CompactPaneLength="48"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="232"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=TitleBar}"
            Transition="FadeInWithSlide"
            TransitionDuration="220">
            <ui:NavigationView.PaneHeader>
                <!-- Состояние всегда на виду: цветной индикатор плюс текст, не только цвет.
                     Видимость и данные шапки и подвала меню задаются в MainWindow.BindPaneParts: привязки с поиском источника здесь ломаются. -->
                <Border x:Name="StatusCard" Margin="8,4,8,12" Padding="12,10" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" views:Tone.Fill="{Binding Home.Tone}" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding StateText}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding StateText, StringFormat=Состояние: {0}}"
                                       views:LiveRegion.Value="{Binding StateText}" />
                        </Grid>
                        <TextBlock Margin="18,2,0,0" FontSize="12" Text="{Binding Status.ProfileName, TargetNullValue=подключение не выбрано}"
                                   ToolTip="{Binding Status.ProfileName, TargetNullValue=подключение не выбрано}"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <!-- Подробный журнал включён: видно всегда, чтобы режим не забылся (он и сам выключится по сроку). -->
                        <ui:Badge Margin="16,6,0,0" HorizontalAlignment="Left" Appearance="Caution" Content="{Binding VerboseBadge}"
                                  Visibility="{Binding VerboseBadge, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </Border>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Главная" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type views:HomePage}" />
                <ui:NavigationViewItem Content="Подключения" Icon="{ui:SymbolIcon PlugConnected24}" TargetPageType="{x:Type views:ConnectionsPage}" />
                <ui:NavigationViewItem Content="Маршрутизация" Icon="{ui:SymbolIcon Globe24}" TargetPageType="{x:Type views:RoutingPage}" />
                <ui:NavigationViewItem Content="Проверить адрес" Icon="{ui:SymbolIcon Search24}" TargetPageType="{x:Type views:CheckAddressPage}" />
                <ui:NavigationViewItem Content="Защита и DNS" Icon="{ui:SymbolIcon ShieldCheckmark24}" TargetPageType="{x:Type views:ProtectionPage}" />
                <ui:NavigationViewItem Content="Диагностика" Icon="{ui:SymbolIcon Pulse24}" TargetPageType="{x:Type views:DiagnosticsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Настройки" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type views:SettingsPage}" />
                <ui:NavigationViewItem Content="О программе" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type views:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.PaneFooter>
                <!-- Служба Windows на виду со всех страниц: состояние и управление ею (действия — с правами администратора). -->
                <Grid x:Name="ServiceFooter">
                    <Border x:Name="ServiceBlock" Margin="8" Padding="12,8,12,10" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <!-- Подпись и версия — строкой выше: состояние («Останавливается…») не делит строку и не обрезается. -->
                            <StackPanel ToolTip="{Binding Description}" Background="Transparent">
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="Служба" /> <Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" views:Tone.Fill="{Binding Tone}" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               AutomationProperties.Name="{Binding Description}" AutomationProperties.LiveSetting="Polite" views:LiveRegion.Value="{Binding Text}" />
                                </Grid>
                            </StackPanel>
                            <UniformGrid Margin="0,8,0,0" Rows="1" Columns="3">
                                <ui:Button Margin="0,0,4,0" Padding="0,6" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Play24}" Command="{Binding StartCommand}"
                                           ToolTip="Запустить службу" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Запустить службу" />
                                <ui:Button Margin="2,0,2,0" Padding="0,6" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopCommand}"
                                           ToolTip="Остановить службу" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Остановить службу" />
                                <ui:Button Margin="4,0,0,0" Padding="0,6" HorizontalAlignment="Stretch" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RestartCommand}"
                                           ToolTip="Перезапустить службу" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Перезапустить службу" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <!-- Свёрнутое меню: значок службы с цветом состояния; управление — в раскрытом меню.
                         Label, а не Grid: у панели нет элемента автоматизации, и диктор не прочёл бы состояние —
                         только цвет точки. Подсказка и имя для диктора — состояние словами. -->
                    <Label x:Name="ServiceIcon" Width="40" Height="32" Margin="4,8,4,4" Padding="0" HorizontalAlignment="Left" Focusable="False"
                           HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="Transparent"
                           ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}">
                        <Grid>
                            <ui:SymbolIcon Symbol="Server24" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Ellipse Width="8" Height="8" Margin="0,0,9,6" HorizontalAlignment="Right" VerticalAlignment="Bottom" views:Tone.Fill="{Binding Tone}" />
                        </Grid>
                    </Label>
                </Grid>
            </ui:NavigationView.PaneFooter>
            <ui:NavigationView.Header>
                <!-- Шапка над страницей не выше 40 % высоты окна (задаётся в MainWindow при смене размера): при низком окне и нескольких
                     сообщениях она прокручивается сама, а странице остаётся место. -->
                <ScrollViewer x:Name="HeaderScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              views:WheelChain.IsEnabled="True">
                <StackPanel MaxWidth="1040" Margin="28,8,28,0">
                    <StackPanel Margin="0,0,0,12"
                                Visibility="{Binding ShowServiceProgress, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding ServiceProgressStage}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   views:LiveRegion.Value="{Binding ServiceProgressStage}" />
                        <ProgressBar Height="5" Margin="0,6,0,4" Minimum="0" Maximum="100"
                                     Value="{Binding ServiceProgressPercent, Mode=OneWay}"
                                     IsIndeterminate="{Binding ServiceProgressIndeterminate}" Focusable="False"
                                     AutomationProperties.Name="{Binding ServiceProgressStage}"
                                     ToolTip="Для маршрутов и фильтров показано число обработанных изменений. Для остальных этапов прогресс примерный." />
                        <TextBlock Text="{Binding ServiceProgressDetail}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <!-- Идёт команда службе или действие страницы: полоса ожидания в шапке. Состояние не только
                         цветом — кнопка действия при этом называет, что происходит («Подключение…»). -->
                    <ProgressBar Height="3" Margin="0,0,0,8" IsIndeterminate="True" Focusable="False"
                                 Visibility="{Binding ShowCommandProgress, Converter={StaticResource VisibleWhen}}"
                                 AutomationProperties.Name="Идёт выполнение" AutomationProperties.LiveSetting="Polite"
                                 views:LiveRegion.Value="{Binding IsWorking}" />
                    <ui:InfoBar Margin="0,0,0,8" IsOpen="{Binding ProxyError, Converter={StaticResource HasValue}, Mode=OneWay}" Severity="Warning"
                                IsClosable="False" Message="{Binding ProxyError}" views:LiveRegion.Value="{Binding ProxyError}" />
                    <!-- Идёт экстренное выключение или включение: окно UAC может быть за другими окнами, а команда идёт минуты. -->
                    <Border Margin="0,0,0,8" Padding="16,12" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding Emergency.IsRunning, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Emergency.RunningText}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" views:LiveRegion.Value="{Binding Emergency.RunningText}" />
                            <ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="True" Focusable="False" AutomationProperties.Name="Идёт выполнение команды" />
                        </StackPanel>
                    </Border>
                    <!-- Программа экстренно выключена: спокойный баннер вместо красной «Служба недоступна» и одна кнопка.
                         Баннер — выше итога команды, а кнопка — рядом с заголовком: при низком окне (шапка не выше 40 % его
                         высоты) она видна без прокрутки шапки. -->
                    <Border x:Name="EmergencyBanner" Margin="0,0,0,8" Padding="16,12" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding Emergency.IsOff, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:SymbolIcon Symbol="Power24" FontSize="20" Margin="0,1,12,0" VerticalAlignment="Top" views:Tone.Foreground="{x:Static views:StateTone.Caution}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Static vm:UiText.EmergencyBannerTitle}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" views:LiveRegion.Value="{Binding Emergency.IsOff}" />
                            <ui:Button x:Name="EmergencyTurnOnButton" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top" Appearance="Primary"
                                       Content="Включить программу" Icon="{ui:SymbolIcon Power24}"
                                       Command="{Binding Emergency.TurnOnCommand}"
                                       AutomationProperties.Name="Включить программу"
                                       AutomationProperties.HelpText="Снять экстренное выключение и запустить службу. Windows запросит права администратора; VPN после этого подключается кнопкой «Подключить»" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Emergency.BannerText}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <!-- Итог команды: что получилось, что делать, шаги и путь к отчёту; виден на любой странице, пока не закрыт.
                         «Скопировать отчёт» и «Закрыть» — рядом с заголовком: при низком окне они видны без прокрутки шапки. -->
                    <Border x:Name="EmergencyResult" Margin="0,0,0,8" Padding="16,12" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding Emergency.Result, Converter={StaticResource VisibleWhen}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ui:SymbolIcon Symbol="{Binding Emergency.Result.Symbol, FallbackValue=Info24}" FontSize="20" Margin="0,1,12,0" VerticalAlignment="Top"
                                           views:Tone.Foreground="{Binding Emergency.Result.Tone, FallbackValue={x:Static views:StateTone.Neutral}}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding Emergency.Result.Title, FallbackValue=''}"
                                       AutomationProperties.Name="{Binding Emergency.Result.Spoken, FallbackValue=''}"
                                       AutomationProperties.LiveSetting="Assertive" views:LiveRegion.Value="{Binding Emergency.Result.Spoken, FallbackValue=''}" />
                            <StackPanel x:Name="EmergencyResultActions" Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Top">
                                <ui:Button Margin="0,0,8,0" Appearance="Secondary" Content="Скопировать отчёт" Icon="{ui:SymbolIcon Copy24}"
                                           Command="{Binding Emergency.CopyReportCommand}" AutomationProperties.Name="Скопировать отчёт" />
                                <ui:Button Appearance="Transparent" Content="Закрыть" Command="{Binding Emergency.CloseResultCommand}"
                                           AutomationProperties.Name="Закрыть итог команды" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding Emergency.Result.Summary, FallbackValue=''}" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding Emergency.Result.Advice, FallbackValue=''}"
                                           Visibility="{Binding Emergency.Result.HasAdvice, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}" />
                                <!-- Раскрыт ли список — свойство модели, заданное заново для каждого итога; дальше его меняет человек (TwoWay). -->
                                <Expander x:Name="EmergencyStepsExpander" Margin="0,8,0,0" HorizontalContentAlignment="Stretch"
                                          Header="{Binding Emergency.Result.StepsHeader, FallbackValue=''}"
                                          IsExpanded="{Binding Emergency.StepsExpanded, Mode=TwoWay}"
                                          Visibility="{Binding Emergency.Result.HasSteps, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                                    <ItemsControl Margin="0,6,0,0" Focusable="False" ItemsSource="{Binding Emergency.Result.Steps, FallbackValue={x:Null}}"
                                                  AutomationProperties.Name="Шаги команды">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6" AutomationProperties.Name="{Binding Spoken}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Margin="0,6,8,0" VerticalAlignment="Top" views:Tone.Fill="{Binding Tone}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding OutcomeText, Mode=OneWay}" FontWeight="SemiBold" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Detail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding Detail, Converter={StaticResource VisibleWhen}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding Emergency.Result.ReportPath, Converter={StaticResource VisibleWhen}, FallbackValue=Collapsed}">
                                    <Run Text="Отчёт: " /><Run Text="{Binding Emergency.Result.ReportPath, Mode=OneWay, FallbackValue=''}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ui:InfoBar
                        Margin="0,0,0,8"
                        IsClosable="False"
                        IsOpen="{Binding ShowServiceError}"
                        Severity="Error"
                        Title="{Binding ServiceErrorTitle}"
                        Message="{Binding ServiceError}"
                        AutomationProperties.Name="{Binding ServiceError}"
                        AutomationProperties.LiveSetting="Assertive"
                        views:LiveRegion.Value="{Binding ServiceError}" />
                    <WrapPanel x:Name="ServiceRecoveryActions" Margin="0,0,0,12"
                               Visibility="{Binding ShowServiceRecovery, Converter={StaticResource VisibleWhen}}">
                        <ui:Button Content="Запустить службу" Appearance="Primary" Margin="0,0,8,4"
                                   Icon="{ui:SymbolIcon Play24}" Command="{Binding ServiceHost.StartCommand}"
                                   Visibility="{Binding ServiceHost.View.CanStart, Converter={StaticResource VisibleWhen}}" />
                        <ui:Button Content="Перезапустить службу" Appearance="Primary" Margin="0,0,8,4"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding ServiceHost.RestartCommand}"
                                   Visibility="{Binding ServiceHost.View.CanRestart, Converter={StaticResource VisibleWhen}}" />
                    </WrapPanel>
                    <ui:InfoBar
                        Margin="0,0,0,8"
                        IsClosable="True"
                        IsOpen="{Binding CurrentPage.Message, Converter={StaticResource HasValue}, Mode=TwoWay}"
                        Severity="{Binding CurrentPage.MessageIsError, Converter={StaticResource ErrorSeverity}}"
                        Message="{Binding CurrentPage.Message}"
                        AutomationProperties.Name="{Binding CurrentPage.Message, TargetNullValue=''}"
                        AutomationProperties.LiveSetting="Assertive"
                        views:LiveRegion.Value="{Binding CurrentPage.Message}" />
                </StackPanel>
                </ScrollViewer>
            </ui:NavigationView.Header>
        </ui:NavigationView>

        <!-- Мастер первого запуска поверх окна. -->
        <Grid x:Name="WizardHost" Grid.Row="1" Background="{DynamicResource ApplicationBackgroundBrush}"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              Visibility="{Binding Wizard, Converter={StaticResource VisibleWhen}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ContentControl Content="{Binding Wizard}" MaxWidth="720" Margin="24" Focusable="False" />
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
